# Database (PostgreSQL — Supabase, Neon, or local)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fintrack_ai"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-random-32-char-string"

# AI Insights (OpenRouter)
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxx"

# Optional OAuth providers (leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
